# Copy to server/.env for local use. On Render, set these in the dashboard instead.

# Password for the owner area (Pipeline + Pitch kit). Leave empty locally to skip login.
ADMIN_PASSWORD=

# Long random string that signs owner logins. Render generates this for you.
AUTH_SECRET=

# MongoDB Atlas connection string. Leave empty to store the pipeline in server/data/prospects.json.
MONGODB_URI=
MONGODB_DB=pulselocal

# Google Places API key for the Lead finder. Leave empty to see sample businesses.
GOOGLE_PLACES_API_KEY=
